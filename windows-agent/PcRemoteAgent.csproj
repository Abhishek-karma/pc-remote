<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Tray application (WinForms NotifyIcon) — no console window in normal
         use; run with the console flag for terminal output (docs/15 §2). -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>PcRemoteAgent</RootNamespace>
    <AssemblyName>PcRemoteAgent</AssemblyName>
    <!-- Single source of truth for the version (docs/15-DEPLOYMENT.md §3).
         Release CI overrides this with -p:Version=<git tag>; keep this default in
         sync with android-app's versionName. -->
    <VersionPrefix>0.1.1</VersionPrefix>
    <Product>PC Remote Agent</Product>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- The agent is Windows-only by design (docs/01-PRODUCT-REQUIREMENTS.md
         non-goals), so CA1416 (platform-specific API) is not actionable. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Makaretu.Dns.Multicast" Version="0.27.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Keep the sibling test project out of this project's default compile glob. -->
    <Compile Remove="PcRemoteAgent.Tests\**" />
    <None Remove="PcRemoteAgent.Tests\**" />
  </ItemGroup>

</Project>
