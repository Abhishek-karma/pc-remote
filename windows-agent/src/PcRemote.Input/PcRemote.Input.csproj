<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The input helper. One small executable with NO project references: it
         cannot reach the network, the pairing store or any other subsystem,
         which is what keeps the secure-desktop path from spreading. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PcRemote.Input</RootNamespace>
    <AssemblyName>PCRemoteInput</AssemblyName>
    <VersionPrefix>0.2.2</VersionPrefix>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <Product>PC Remote Input Helper</Product>
    <ApplicationIcon>..\..\app.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PcRemote.Tests" />
  </ItemGroup>

</Project>