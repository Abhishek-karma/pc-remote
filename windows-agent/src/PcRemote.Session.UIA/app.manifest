<?xml version="1.0" encoding="utf-8"?>
<!--
  UIAccess manifest (requirement 3):
    * requestedExecutionLevel stays asInvoker — the helper is launched by the
      service with the user's token; it must NOT be requireAdministrator.
    * uiAccess=true lets SendInput reach elevated windows from the user
      session without weakening UAC anywhere else on the system.
  Windows requires ALL of: uiAccess=true, Authenticode signature, installed
  under a secure location (Program Files), launched via CreateProcess with
  the user token. The installer places this binary in Program Files and CI
  signs it; without a signature the OS refuses to start it and the service
  falls back to the non-UIAccess helper.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0" xmlns:asmv3="urn:schemas-microsoft-com:asm.v3">
  <asmv3:trustInfo>
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="asInvoker" uiAccess="true" />
      </requestedPrivileges>
    </security>
  </asmv3:trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
  <asmv3:application>
    <asmv3:windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </asmv3:windowsSettings>
  </asmv3:application>
</assembly>
