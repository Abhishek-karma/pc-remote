  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PcRemote.Core\PcRemote.Core.csproj" />
    <ProjectReference Include="..\PcRemote.Service\PcRemote.Service.csproj" />
  </ItemGroup>

</Project>
