<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher foreground: precision remote trackpad/mouse glyph in Electric Cyan.
     108dp viewport, with the glyph kept inside the 66dp safe circle. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer precision frame: centered rounded container -->
    <path
        android:fillColor="#151B22"
        android:pathData="M35,28 h38 a8,8 0 0 1 8,8 v36 a8,8 0 0 1 -8,8 h-38 a8,8 0 0 1 -8,-8 v-36 a8,8 0 0 1 8,-8 z" />

    <!-- Cyan border accent -->
    <path
        android:strokeColor="#00E5FF"
        android:strokeWidth="2"
        android:pathData="M35,28 h38 a8,8 0 0 1 8,8 v36 a8,8 0 0 1 -8,8 h-38 a8,8 0 0 1 -8,-8 v-36 a8,8 0 0 1 8,-8 z" />

    <!-- Top Touchpad surface subtle divider -->
    <path
        android:fillColor="#00E5FF"
        android:pathData="M34,58 h40 v2 h-40 z" />

    <!-- Left / Right Click Deck divider -->
    <path
        android:fillColor="#00E5FF"
        android:pathData="M53,60 h2 v20 h-2 z" />

    <!-- Precision Reticle Crosshair in Trackpad area -->
    <path
        android:fillColor="#38EFFF"
        android:pathData="M52,42 h4 v4 h-4 z" />
    <path
        android:fillColor="#00E5FF"
        android:pathData="M48,43.5 h3 v1 h-3 z" />
    <path
        android:fillColor="#00E5FF"
        android:pathData="M57,43.5 h3 v1 h-3 z" />
    <path
        android:fillColor="#00E5FF"
        android:pathData="M53.5,38 h1 v3 h-1 z" />
    <path
        android:fillColor="#00E5FF"
        android:pathData="M53.5,47 h1 v3 h-1 z" />

    <!-- Radio / Wi-Fi broadcast wave at top right corner -->
    <path
        android:strokeColor="#00E5FF"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:pathData="M70,33 a4,4 0 0 1 3,3" />
    <path
        android:strokeColor="#38EFFF"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:pathData="M67,36 a1,1 0 0 1 1,1" />
</vector>
