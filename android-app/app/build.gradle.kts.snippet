// Add these to your app-module build.gradle.kts (alongside the usual
// Compose/AndroidX boilerplate from a new "Empty Activity" project template).

dependencies {
    // WebSocket client
    implementation("com.squareup.okhttp3:okhttp:4.12.0")

    // JSON serialization for the RemoteMessage protocol
    implementation("org.jetbrains.kotlinx:kotlinx-serialization-json:1.6.3")

    // Compose (adjust versions to match your project's BOM)
    implementation(platform("androidx.compose:compose-bom:2024.09.00"))
    implementation("androidx.compose.material3:material3")
    implementation("androidx.compose.ui:ui")
    implementation("androidx.activity:activity-compose:1.9.2")
    implementation("androidx.lifecycle:lifecycle-runtime-compose:2.8.6")
}

// Also add the Kotlin serialization plugin in your top-level plugins block:
//   plugins {
//       id("org.jetbrains.kotlin.plugin.serialization") version "1.9.24"
//   }
